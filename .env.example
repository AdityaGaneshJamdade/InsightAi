# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your-gemini-api-key"

# Ordered model fallback pool, tried left to right until one returns valid JSON.
# Free-tier quota is per model, so a 429 on one model does not block the others.
GEMINI_MODELS="gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview"

# Optional FastAPI backend (python_backend/). Empty means the Node pipeline handles everything.
PYTHON_BACKEND_URL=""



